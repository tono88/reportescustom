<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_current_balance_report_wizard_form" model="ir.ui.view">
        <field name="name">current.balance.report.wizard.form</field>
        <field name="model">current.balance.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Saldos de clientes/proveedores - estado actual">
                <group>
                    <group>
                        <field name="report_type"/>
                        <field name="company_id" options="{'no_create': True}"/>
                        <field name="invoice_filter" invisible="report_type != 'customer'"/>
                    </group>
                    <group>
                        <field name="use_oldest_date"/>
                        <field name="date_from" readonly="use_oldest_date"/>
                        <field name="date_to"/>
                        <field name="include_paid"/>
                    </group>
                </group>
                <group>
                    <field name="partner_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </group>
                <div class="alert alert-info" role="alert">
                    <strong>Fecha inicial automática:</strong>
                    al activar “Usar fecha más antigua automáticamente”, Odoo calcula la fecha inicial más antigua
                    disponible según compañía, tipo de reporte, facturación, terceros y fecha final. Solo debe elegir
                    manualmente la fecha final.<br/>
                    <strong>Facturados:</strong>
                    la fecha corresponde a la factura y el saldo considera todos los pagos conciliados hasta hoy,
                    aunque hayan sido registrados después del período.<br/>
                    <strong>No facturados:</strong>
                    se toman de pedidos de Punto de Venta sin factura, usando la fecha del pedido POS. El saldo se
                    calcula individualmente con el mismo criterio del reporte POS existente: efectivo = pagado y
                    otros métodos de pago = crédito/saldo pendiente.
                </div>
                <footer>
                    <button name="action_export_xlsx" type="object" string="Descargar Excel" class="btn-primary"/>
                    <button name="action_print_pdf" type="object" string="Imprimir PDF" class="btn-secondary"/>
                    <button name="action_open_invoices" type="object" string="Ver facturas" class="btn-secondary"
                            invisible="report_type == 'customer' and invoice_filter == 'not_invoiced'"/>
                    <button name="action_open_pos_orders" type="object" string="Ver pedidos POS" class="btn-secondary"
                            invisible="report_type != 'customer' or invoice_filter == 'invoiced'"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_current_balance_report_customer" model="ir.actions.act_window">
        <field name="name">Saldos actuales de clientes</field>
        <field name="res_model">current.balance.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_current_balance_report_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'customer', 'default_invoice_filter': 'invoiced'}</field>
    </record>

    <record id="action_current_balance_report_vendor" model="ir.actions.act_window">
        <field name="name">Saldos actuales de proveedores</field>
        <field name="res_model">current.balance.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_current_balance_report_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'vendor', 'default_invoice_filter': 'invoiced'}</field>
    </record>

    <menuitem id="menu_current_balance_report_customer"
              name="Saldos actuales de clientes"
              parent="account.account_reports_partners_reports_menu"
              action="action_current_balance_report_customer"
              sequence="80"
              groups="account.group_account_invoice,account.group_account_readonly"/>

    <menuitem id="menu_current_balance_report_vendor"
              name="Saldos actuales de proveedores"
              parent="account.account_reports_partners_reports_menu"
              action="action_current_balance_report_vendor"
              sequence="81"
              groups="account.group_account_invoice,account.group_account_readonly"/>
</odoo>
