<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_current_balance" model="ir.actions.report">
        <field name="name">Saldos por fecha de factura - estado actual</field>
        <field name="model">current.balance.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">current_invoice_balance_report.report_current_balance_document</field>
        <field name="report_file">current_invoice_balance_report.report_current_balance_document</field>
        <field name="print_report_name">'Saldos_%s_%s_%s' % (object.report_type, object.date_from, object.date_to)</field>
    </record>

    <template id="report_current_balance_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <t t-set="company" t-value="wizard.company_id"/>
                <t t-set="data" t-value="wizard.get_report_data()"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            <t t-if="wizard.report_type == 'customer'">Saldos de clientes</t>
                            <t t-else="">Saldos de proveedores</t>
                            <span> - estado actual</span>
                        </h2>
                        <p>
                            <strong>Compañía:</strong> <span t-field="wizard.company_id.name"/><br/>
                            <strong>Fecha de factura:</strong>
                            <span t-field="wizard.date_from"/> a <span t-field="wizard.date_to"/><br/>
                            <strong>Criterio:</strong>
                            documentos del periodo con pagos y conciliaciones aplicados hasta el momento de generar este reporte.
                        </p>

                        <t t-if="not data['groups']">
                            <div class="alert alert-warning">No se encontraron documentos con los filtros seleccionados.</div>
                        </t>

                        <t t-foreach="data['groups']" t-as="group">
                            <h4 class="mt-3">
                                <span t-esc="group['partner'].display_name if group['partner'] else 'Sin tercero'"/>
                            </h4>
                            <table class="table table-sm table-bordered" style="font-size: 10px;">
                                <thead>
                                    <tr>
                                        <th>Documento</th>
                                        <th>Referencia</th>
                                        <th>Fecha factura</th>
                                        <th>Vencimiento</th>
                                        <th class="text-end">Total</th>
                                        <th class="text-end">Pagado actual</th>
                                        <th class="text-end">Saldo actual</th>
                                        <th>Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="group['lines']" t-as="line">
                                        <td><span t-esc="line['number']"/></td>
                                        <td><span t-esc="line['reference']"/></td>
                                        <td><span t-field="line['move'].invoice_date"/></td>
                                        <td><span t-field="line['move'].invoice_date_due"/></td>
                                        <td class="text-end">
                                            <span t-out="line['total']" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                        </td>
                                        <td class="text-end">
                                            <span t-out="line['paid']" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                        </td>
                                        <td class="text-end">
                                            <span t-out="line['residual']" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                        </td>
                                        <td><span t-esc="line['payment_state']"/></td>
                                    </tr>
                                    <tr class="fw-bold">
                                        <td colspan="4">Subtotal</td>
                                        <td class="text-end">
                                            <span t-out="group['total']" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                        </td>
                                        <td class="text-end">
                                            <span t-out="group['paid']" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                        </td>
                                        <td class="text-end">
                                            <span t-out="group['residual']" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                        </td>
                                        <td/>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <t t-if="data['groups']">
                            <table class="table table-sm mt-4" style="font-size: 11px;">
                                <tbody>
                                    <tr class="fw-bold">
                                        <td>TOTAL GENERAL (<span t-esc="data['move_count']"/> documentos)</td>
                                        <td class="text-end">
                                            Total:
                                            <span t-out="data['grand_total']" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                        </td>
                                        <td class="text-end">
                                            Pagado:
                                            <span t-out="data['grand_paid']" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                        </td>
                                        <td class="text-end">
                                            Saldo:
                                            <span t-out="data['grand_residual']" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
