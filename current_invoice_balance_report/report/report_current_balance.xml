<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_current_balance" model="ir.actions.report">
        <field name="name">Saldos de clientes/proveedores - estado actual</field>
        <field name="model">current.balance.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">current_invoice_balance_report.report_current_balance_document</field>
        <field name="report_file">current_invoice_balance_report.report_current_balance_document</field>
        <field name="print_report_name">'Saldos_%s_%s_%s' % (object.report_type, object.date_from, object.date_to)</field>
    </record>

    <template id="report_current_balance_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <t t-set="company" t-value="wizard.company_id"/>
                <t t-set="data" t-value="wizard.get_report_data()"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            <t t-if="wizard.report_type == 'customer'">Saldos de clientes</t>
                            <t t-else="">Saldos de proveedores</t>
                            <span> - estado actual</span>
                        </h2>
                        <p>
                            <strong>Compañía:</strong> <span t-field="wizard.company_id.name"/><br/>
                            <strong>Periodo:</strong> <span t-field="wizard.date_from"/> a <span t-field="wizard.date_to"/><br/>
                            <t t-if="wizard.report_type == 'customer'">
                                <strong>Facturación:</strong>
                                <span t-esc="dict(wizard._fields['invoice_filter']._description_selection(wizard.env)).get(wizard.invoice_filter, wizard.invoice_filter)"/>
                            </t>
                        </p>

                        <t t-if="not data['rows']">
                            <div class="alert alert-warning">No se encontraron registros con los filtros seleccionados.</div>
                        </t>

                        <t t-if="data['rows']">
                            <table class="table table-sm table-bordered" style="font-size: 9px;">
                                <thead>
                                    <tr>
                                        <th>Fecha factura</th>
                                        <th><t t-if="wizard.report_type == 'customer'">Cliente</t><t t-else="">Proveedor</t></th>
                                        <th>Orden POS</th>
                                        <th>DTE FEL</th>
                                        <th class="text-end">Total factura</th>
                                        <th class="text-end">Total pagado</th>
                                        <th class="text-end">Saldo pendiente</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="data['rows']" t-as="line">
                                        <td><span t-esc="line['date']"/></td>
                                        <td><span t-esc="line['partner_name']"/></td>
                                        <td><span t-esc="line['pos_order']"/></td>
                                        <td><span t-esc="line['dte_fel']"/></td>
                                        <td class="text-end">
                                            <span t-out="line['total']" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                        </td>
                                        <td class="text-end">
                                            <span t-out="line['paid']" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                        </td>
                                        <td class="text-end">
                                            <span t-out="line['residual']" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr class="fw-bold">
                                        <td colspan="4" class="text-end">TOTAL</td>
                                        <td class="text-end">
                                            <span t-out="data['grand_total']" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                        </td>
                                        <td class="text-end">
                                            <span t-out="data['grand_paid']" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                        </td>
                                        <td class="text-end">
                                            <span t-out="data['grand_residual']" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
