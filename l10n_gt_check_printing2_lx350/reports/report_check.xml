<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_personal" model="report.paperformat">
        <field name="name">Banrural Personal LX-350</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_width">165.1</field>
        <field name="page_height">69.85</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>
    <record id="action_check_personal" model="ir.actions.report">
        <field name="name">Cheque Banrural Personal LX-350</field>
        <field name="model">account.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_gt_check_printing2_lx350.check_personal</field>
        <field name="paperformat_id" ref="paperformat_personal"/>
        <field name="print_report_name">'Cheque Banrural - %s' % object.display_name</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>
    <template id="check_personal">
        <t t-call="l10n_gt_check_printing2_lx350.check_document"/>
    </template>
    <record id="action_calibration_personal" model="ir.actions.report">
        <field name="name">PRUEBA SIN VALOR Banrural Personal LX-350</field>
        <field name="model">account.journal</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_gt_check_printing2_lx350.calibration_personal</field>
        <field name="paperformat_id" ref="paperformat_personal"/>
        <field name="print_report_name">'PRUEBA SIN VALOR Banrural - %s' % object.display_name</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>
    <template id="calibration_personal">
        <t t-call="l10n_gt_check_printing2_lx350.check_document"/>
    </template>
    <record id="paperformat_commercial" model="report.paperformat">
        <field name="name">Banrural Comercial LX-350</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_width">190.5</field>
        <field name="page_height">69.85</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>
    <record id="action_check_commercial" model="ir.actions.report">
        <field name="name">Cheque Banrural Comercial LX-350</field>
        <field name="model">account.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_gt_check_printing2_lx350.check_commercial</field>
        <field name="paperformat_id" ref="paperformat_commercial"/>
        <field name="print_report_name">'Cheque Banrural - %s' % object.display_name</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>
    <template id="check_commercial">
        <t t-call="l10n_gt_check_printing2_lx350.check_document"/>
    </template>
    <record id="action_calibration_commercial" model="ir.actions.report">
        <field name="name">PRUEBA SIN VALOR Banrural Comercial LX-350</field>
        <field name="model">account.journal</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_gt_check_printing2_lx350.calibration_commercial</field>
        <field name="paperformat_id" ref="paperformat_commercial"/>
        <field name="print_report_name">'PRUEBA SIN VALOR Banrural - %s' % object.display_name</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>
    <template id="calibration_commercial">
        <t t-call="l10n_gt_check_printing2_lx350.check_document"/>
    </template>
    <template id="check_document">
        <html>
            <head>
                <meta charset="utf-8"/>
                <style>
                    html, body, main { margin:0; padding:0; }
                    body { font-family:Arial,sans-serif; color:#000; }
                    .check-page { position:relative; box-sizing:border-box; page-break-after:always; page-break-inside:avoid; }
                    .check-page:last-child { page-break-after:auto; }
                </style>
            </head>
            <body>
                <main>
                    <t t-foreach="rows" t-as="row">
                        <!-- Slightly less than the paper height prevents rounding from adding a blank page. -->
                        <div class="article check-page" t-attf-style="width:{{ width }}mm;height:{{ height - 0.5 }}mm;">
                            <t t-foreach="row['lines']" t-as="line">
                                <div t-att-style="line['style']"><t t-out="line['text']"/></div>
                            </t>
                            <t t-if="calibration">
                                <div t-attf-style="position:absolute;left:3mm;top:4.2mm;width:{{ width - 6 }}mm;height:49.65mm;border:0.15mm dashed #555;box-sizing:border-box;"/>
                                <div style="position:absolute;left:20mm;top:46mm;font-size:8pt;">PRUEBA SIN VALOR — IMPRIMIR EN PAPEL COMÚN</div>
                            </t>
                        </div>
                    </t>
                </main>
            </body>
        </html>
    </template>
</odoo>
