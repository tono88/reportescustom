<odoo>
    <record id="dashboard_list" model="ir.ui.view">
        <field name="name">tecnodyne.dashboard.list</field>
        <field name="model">tecnodyne.dashboard</field>
        <field name="arch" type="xml">
            <list><field name="sequence" widget="handle"/><field name="name"/><field name="company_id"/>
                <button name="action_open" type="object" string="Open" icon="fa-dashboard"/>
            </list>
        </field>
    </record>
    <record id="item_form" model="ir.ui.view">
        <field name="name">tecnodyne.dashboard.item.form</field>
        <field name="model">tecnodyne.dashboard.item</field>
        <field name="arch" type="xml">
            <form string="Dashboard item"><sheet><group>
                <field name="name"/><field name="dashboard_id"/><field name="sequence"/>
                <field name="model_id" options="{'no_create': True}"/><field name="kind"/>
                <field name="aggregation"/>
                <field name="measure_id" domain="[('model_id', '=', model_id), ('store', '=', True), ('ttype', 'in', ['integer', 'float', 'monetary'])]" options="{'no_create': True}" invisible="aggregation == 'count'"/>
                <field name="group_field_id" domain="[('model_id', '=', model_id), ('store', '=', True)]" options="{'no_create': True}" invisible="kind == 'kpi'"/>
                <field name="interval" invisible="kind == 'kpi'"/>
                <field name="date_field_id" domain="[('model_id', '=', model_id), ('ttype', 'in', ['date', 'datetime']), ('store', '=', True)]" options="{'no_create': True}"/>
                <field name="domain_json"/><field name="limit"/><field name="target"/><field name="unit"/>
            </group></sheet></form>
        </field>
    </record>
    <record id="dashboard_form" model="ir.ui.view">
        <field name="name">tecnodyne.dashboard.form</field>
        <field name="model">tecnodyne.dashboard</field>
        <field name="arch" type="xml">
            <form><header><button name="action_open" type="object" string="Open dashboard" class="oe_highlight"/></header>
                <sheet><group><field name="name"/><field name="company_id"/><field name="active"/><field name="sequence"/>
                    <field name="group_ids" widget="many2many_tags"/></group>
                    <field name="item_ids"><list><field name="sequence" widget="handle"/><field name="name"/><field name="model_id"/><field name="kind"/></list></field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="dashboard_action" model="ir.actions.act_window">
        <field name="name">Tecnodyne Dashboards</field><field name="res_model">tecnodyne.dashboard</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="dashboard_root" name="Tecnodyne" sequence="35" groups="group_dashboard_user"/>
    <menuitem id="dashboard_menu" name="Dashboards" parent="dashboard_root" action="dashboard_action"/>
</odoo>
