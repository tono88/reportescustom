<odoo>
    <record id="dashboard_features" model="ir.ui.view">
        <field name="name">tecnodyne.dashboard.features</field><field name="model">tecnodyne.dashboard</field><field name="inherit_id" ref="dashboard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside"><button name="action_publish_menu" type="object" string="Publish menu / home action" groups="base.group_system"/><button name="action_apply_template" type="object" string="Add template"/></xpath>
            <xpath expr="//field[@name='group_ids']" position="after"><field name="theme"/><field name="layout_template"/><field name="template"/><field name="action_id"/></xpath>
            <xpath expr="//field[@name='item_ids']" position="after"><field name="filter_ids"><list editable="bottom"><field name="name"/><field name="model_id"/><field name="domain_json"/></list></field></xpath>
        </field>
    </record>
    <record id="item_features" model="ir.ui.view">
        <field name="name">tecnodyne.dashboard.item.features</field><field name="model">tecnodyne.dashboard.item</field><field name="inherit_id" ref="item_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="after">
                <notebook>
                    <page string="Analysis"><group>
                        <field name="domain_json" string="Advanced JSON domain (dynamic tokens)"/>
                        <field name="measure2_id" domain="[('model_id', '=', model_id)]"/>
                        <field name="extra_measure_ids" widget="many2many_tags" domain="[('model_id', '=', model_id), ('ttype', 'in', ['integer', 'float', 'monetary'])]"/>
                        <field name="comparison_item_id"/><field name="kpi_operation"/><field name="target_style"/><field name="tile_style"/>
                        <field name="secondary_as_line"/><field name="cumulative_as_line"/>
                        <field name="subgroup_id" domain="[('model_id', '=', model_id)]"/>
                        <field name="drill_field_ids" widget="many2many_tags" domain="[('model_id', '=', model_id)]"/>
                        <field name="list_field_ids" widget="many2many_tags" domain="[('model_id', '=', model_id)]"/>
                        <field name="latitude_id" domain="[('model_id', '=', model_id)]"/><field name="longitude_id" domain="[('model_id', '=', model_id)]"/>
                        <field name="sort"/><field name="preset"/><field name="comparison"/><field name="multiplier"/>
                        <field name="cumulative"/><field name="fill_gaps"/><field name="client_action_id"/>
                    </group></page>
                    <page string="Appearance and access"><group><field name="group_ids" widget="many2many_tags"/><field name="icon"/><field name="color"/><field name="currency_id"/><field name="number_format"/><field name="stacked"/><field name="show_values"/><field name="show_legend"/></group></page>
                    <page string="Targets"><field name="target_ids"><list editable="bottom"><field name="date"/><field name="value"/></list></field></page>
                    <page string="Checklist"><field name="task_ids"><list editable="bottom"><field name="name"/><field name="done"/></list></field></page>
                </notebook>
            </xpath>
            <xpath expr="//form" position="inside"><chatter/></xpath>
        </field>
    </record>
    <record id="item_conversation" model="ir.ui.view">
        <field name="name">tecnodyne.dashboard.item.conversation</field><field name="model">tecnodyne.dashboard.item</field>
        <field name="priority">100</field>
        <field name="arch" type="xml"><form create="0" edit="0" delete="0"><sheet><h1><field name="name"/></h1></sheet><chatter/></form></field>
    </record>
    <record id="transfer_features" model="ir.ui.view">
        <field name="name">tecnodyne.dashboard.transfer.features</field><field name="model">tecnodyne.dashboard.transfer</field><field name="inherit_id" ref="transfer_form"/>
        <field name="arch" type="xml"><field name="dashboard_id" position="after"><field name="item_id"/><field name="import_into_dashboard"/></field></field>
    </record>
    <record id="import_form" model="ir.ui.view">
        <field name="name">tecnodyne.dashboard.import.form</field><field name="model">tecnodyne.dashboard.import</field>
        <field name="arch" type="xml"><form><group><field name="name"/><field name="dashboard_id"/><field name="dataset_id"/><field name="file" filename="filename"/><field name="filename" invisible="1"/></group>
            <group string="Column mapping"><field name="label_column"/><field name="category_column"/><field name="value_column"/><field name="value2_column"/><field name="date_column"/><field name="latitude_column"/><field name="longitude_column"/><field name="amount_column"/><field name="currency_column"/></group>
            <p>CSV UTF-8 / XLSX. Enter the original column headers above. Only the label column is required. Maximum 10,000 rows.</p>
            <footer><button name="action_import" string="Import and synchronize" type="object" class="btn-primary"/><button string="Close" special="cancel"/></footer></form></field>
    </record>
    <record id="import_action" model="ir.actions.act_window"><field name="name">CSV / Excel data</field><field name="res_model">tecnodyne.dashboard.import</field><field name="view_mode">form</field><field name="target">new</field></record>
    <menuitem id="import_menu" name="CSV / Excel data" parent="dashboard_root" action="import_action" groups="group_dashboard_manager"/>
    <record id="generate_form" model="ir.ui.view">
        <field name="name">tecnodyne.dashboard.generate.form</field><field name="model">tecnodyne.dashboard.generate</field>
        <field name="arch" type="xml"><form><group><field name="name"/><field name="dashboard_id"/><field name="model_id"/><field name="keywords"/><field name="proposal"/></group>
            <p>The configured Ollama service receives authorized schema for generation. Chart explanations send the visible aggregate values to that service.</p>
            <footer><button name="action_generate" string="Generate proposal" type="object"/><button name="action_apply" string="Apply reviewed proposal" type="object" class="btn-primary"/><button string="Close" special="cancel"/></footer></form></field>
    </record>
    <record id="generate_action" model="ir.actions.act_window"><field name="name">Generate with AI</field><field name="res_model">tecnodyne.dashboard.generate</field><field name="view_mode">form</field><field name="target">new</field></record>
    <menuitem id="generate_menu" name="Generate with AI" parent="dashboard_root" action="generate_action" groups="group_dashboard_manager"/>
    <record id="move_form" model="ir.ui.view">
        <field name="name">tecnodyne.dashboard.move.form</field><field name="model">tecnodyne.dashboard.move</field>
        <field name="arch" type="xml"><form><group><field name="item_id"/><field name="dashboard_id"/><field name="duplicate"/></group><footer><button name="action_apply" string="Apply" type="object" class="btn-primary"/><button string="Close" special="cancel"/></footer></form></field>
    </record>
    <record id="move_action" model="ir.actions.act_window"><field name="name">Move / duplicate item</field><field name="res_model">tecnodyne.dashboard.move</field><field name="view_mode">form</field><field name="target">new</field></record>
    <menuitem id="move_menu" name="Move / duplicate item" parent="dashboard_root" action="move_action" groups="group_dashboard_manager"/>
    <record id="ai_settings" model="ir.ui.view">
        <field name="name">tecnodyne.dashboard.ai.settings</field><field name="model">res.config.settings</field><field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml"><xpath expr="//form" position="inside"><app name="tecnodyne_dashboard" string="Tecnodyne AI" groups="base.group_system"><block title="Local AI connection"><setting string="Provider"><field name="td_ai_provider"/></setting><setting string="Service URL" help="Ollama: http://127.0.0.1:11434 — LM Studio: http://127.0.0.1:1234/v1"><field name="td_ollama_url" placeholder="http://127.0.0.1:1234/v1"/></setting><setting string="Model identifier" help="Copy the exact identifier from your server. Do not use an embedding model."><field name="td_ollama_model" placeholder="Exact loaded model identifier"/></setting><setting string="API token (optional)"><field name="td_ai_key" password="True"/></setting><setting string="Test connection" help="Saves these settings and checks the model list without generating content."><button name="action_td_check_connection" type="object" string="Save and test connection" class="btn-primary"/></setting></block></app></xpath></field>
    </record>
    <record id="favorites_action" model="ir.actions.act_window"><field name="name">Favorite dashboards</field><field name="res_model">tecnodyne.dashboard.preference</field><field name="view_mode">list,form</field><field name="domain">[('favorite', '=', True)]</field></record>
    <record id="preference_list" model="ir.ui.view"><field name="name">tecnodyne.dashboard.preference.list</field><field name="model">tecnodyne.dashboard.preference</field><field name="arch" type="xml"><list create="0"><field name="dashboard_id"/><field name="favorite"/><button name="action_open" type="object" string="Open"/></list></field></record>
    <menuitem id="favorites_menu" name="Favorites" parent="dashboard_root" action="favorites_action"/>
    <record id="filter_form" model="ir.ui.view"><field name="name">tecnodyne.dashboard.filter.form</field><field name="model">tecnodyne.dashboard.filter</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="dashboard_id"/><field name="model_id"/><field name="model_name" invisible="1"/><field name="domain_json" widget="td_json_domain"/></group></sheet></form></field></record>
    <record id="filter_list" model="ir.ui.view"><field name="name">tecnodyne.dashboard.filter.list</field><field name="model">tecnodyne.dashboard.filter</field><field name="arch" type="xml"><list><field name="name"/><field name="dashboard_id"/><field name="model_id"/></list></field></record>
    <record id="filter_action" model="ir.actions.act_window"><field name="name">Filters</field><field name="res_model">tecnodyne.dashboard.filter</field><field name="view_mode">list,form</field></record>
    <menuitem id="filter_menu" name="Filters" parent="dashboard_root" action="filter_action" groups="group_dashboard_manager"/>
</odoo>
