<odoo>
    <record id="group_dashboard_user" model="res.groups">
        <field name="name">Tecnodyne Dashboard Viewer</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_dashboard_manager" model="res.groups">
        <field name="name">Tecnodyne Dashboard Designer</field>
        <field name="implied_ids" eval="[(4, ref('group_dashboard_user'))]"/>
    </record>
    <record id="dashboard_company_rule" model="ir.rule">
        <field name="name">Dashboard companies</field>
        <field name="model_id" ref="model_tecnodyne_dashboard"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="dashboard_group_rule" model="ir.rule">
        <field name="name">Dashboard audience</field>
        <field name="model_id" ref="model_tecnodyne_dashboard"/>
        <field name="domain_force">['|', ('group_ids', '=', False), ('group_ids', 'in', user.groups_id.ids)]</field>
    </record>
    <record id="item_company_rule" model="ir.rule">
        <field name="name">Dashboard item companies and audience</field>
        <field name="model_id" ref="model_tecnodyne_dashboard_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids), '|', ('dashboard_id.group_ids', '=', False), ('dashboard_id.group_ids', 'in', user.groups_id.ids)]</field>
    </record>
</odoo>
